# N5 frame list: its SHA-256 is pinned in scripts/analyze_n5.py (FRAME_LIST_SHA256) and run_n5.py guard 2 hashes
# the working file, so checkout must not change its bytes (core.autocrlf=true would add CRs).
results/n5_atlantic/frame_list_atlantic.txt -text
# N5 run logs and H9 CSVs: their SHA-256s are in the run manifests, and train.py/evaluate.py wrote CRLF (Windows)
# while the driver wrote LF, so they are stored and checked out byte-for-byte.
results/n5_atlantic/*_h9.csv -text
logs/n5_atlantic/*.log -text
# N5 analysis outputs, manifests, phase-2 marker and their decision records: kept byte-for-byte too, so a
# checkout reproduces the recorded SHA-256s exactly.
results/n5_atlantic/analysis/* -text
logs/n5_atlantic/runs/*_seed[0-9].json -text
logs/n5_atlantic/phase2_started.json -text
reports/decisions/PR1[0-4].md -text
reports/decisions/N5-result.md -text
# F-31 (reports/v2_survey/f31/design.md §13): the driver compares the 40 training records with their HEAD blobs, and
# the manifests pin the SHA-256 of every train log, eval log and H9 CSV (train.py and evaluate.py write CRLF on
# Windows, the driver LF). So every F-31 output is stored and checked out byte-for-byte, autocrlf or not.
logs/f31/runs/*.json -text
logs/f31/*.log -text
logs/f31/phase2_started.json -text
logs/f31/deviations.json -text
logs/f31/aborted/** -text
results/f31/*_h9.csv -text
results/f31/analysis/* -text
# John's v2 note after F-31 (decisions.md 2026-10-21 16:23 and 18:37 entries): its SHA-256 is recorded there, so it is
# stored and checked out byte-for-byte.
reports/v2_survey/f31/v2_implications.md -text
# v2 recipe (reports/v2_survey/v2_recipe/design.md §5): the records pin the SHA-256 of each train log and member, and
# the members file's blob hash is recorded at the freeze; every committed output is stored and checked out byte-for-byte.
logs/v2_recipe/*.log -text
logs/v2_recipe/runs/*.json -text
logs/v2_recipe/aborted/** -text
results/v2_recipe/* -text
reports/decisions/V2-*.md -text
